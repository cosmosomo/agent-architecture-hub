# dependencies and build output
node_modules/
dist/

# the reference corpus: about 250 MB of machine-written cases, generated on the author's machine
# by hub/tools/_reference/import_*.js. Only its README is committed.
hub/cases/_reference/*
!hub/cases/_reference/README.md

# parsed sessions are private: they stay on the machine they came from
trace-data/
*.local.json

