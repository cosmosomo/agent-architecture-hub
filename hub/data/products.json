{
  "about": "产品表：本机每个智能体产品一行，是唯一的产品名单。后端（gateway.ts 的 CHANNEL_PROFILES）和命令行网关（agent_gateway.js）都从这里取，不再各写一份。routes 写每条适配路线上每个动作实际执行的命令；codeMark 是它在 gateway.ts 里的特征串，probe/scripts/tables.js 核对它还在，对不上就报出来。env 里的 {HOME} 在启动时展开；envFrom 表示要在启动时从别处读（只有 Claude 一处，代码在 claudeProviderEnv）。 maxConcurrent：这个产品同时最多跑几轮，中心自动选派给谁时，跑满了的不选。",
  "routes": {
    "acpx": {
      "does": "经 acpx 走各产品的 ACP 桥；每一轮起一个 acpx 进程，会话状态记在 ~/.acpx/sessions/",
      "verbs": {
        "new": {
          "command": "acpx --format json --cwd <目录> [--model <模型>] [--append-system-prompt <全局说明>] <acpxAgent> sessions ensure --name <会话名> [--resume-session <原生编号>]",
          "codeMark": "'ensure'"
        },
        "send": {
          "command": "acpx --format json <权限> --timeout <秒> --cwd <目录> [--model <模型>] <acpxAgent> prompt -s <会话名> -f -（话从 stdin 进，带图时是 ACP 内容块数组）",
          "codeMark": "'prompt', '-s'"
        },
        "cancel": {
          "command": "acpx --format json <acpxAgent> cancel -s <会话名>，再结束这一轮的进程",
          "codeMark": "cancel -s"
        },
        "set-model": {
          "command": "acpx --cwd <目录> <acpxAgent> set-model <模型> -s <会话名>",
          "codeMark": "'set-model'"
        }
      }
    },
    "agentapi": {
      "does": "Antigravity 自带的 language_server.exe（由 gateway.ts 的 discoverAntigravityLs 找到路径、端口和 csrf）",
      "verbs": {
        "new": {
          "command": "language_server.exe agentapi new-conversation --model=<档位> --title=<标题> <话>",
          "codeMark": "'new-conversation'"
        },
        "send": {
          "command": "language_server.exe agentapi send-message <对话编号> <话>",
          "codeMark": "'send-message'"
        },
        "cancel": {
          "command": "POST http://127.0.0.1:<端口>/exa.language_server_pb.LanguageServerService/CancelCascadeInvocation",
          "codeMark": "CancelCascadeInvocation"
        }
      }
    },
    "opencli": {
      "does": "经 OpenCLI 用 CDP 操作桌面端界面；同一时刻只能一个写者，会和人抢窗口",
      "verbs": {
        "send": {
          "command": "opencli <产品> send <话>",
          "codeMark": null
        }
      }
    },
    "app-server": {
      "does": "Codex 的常驻 JSON-RPC 服务（codex app-server，stdio）。驱动在 trace/apps/cli/src/drivers/codex_app_server.ts，已接进后端 gateway.ts",
      "inBackend": true,
      "verbs": {
        "new": {
          "command": "thread/start（再 thread/name/set 命名）",
          "codeMark": "'thread/start'"
        },
        "resume": {
          "command": "thread/resume，重启后要重新带上 model、modelProvider、cwd、sandbox、approvalPolicy",
          "codeMark": "'thread/resume'"
        },
        "send": {
          "command": "turn/start",
          "codeMark": "'turn/start'"
        },
        "steer": {
          "command": "turn/steer（带 expectedTurnId，插进当前这一轮）",
          "codeMark": "'turn/steer'"
        },
        "cancel": {
          "command": "turn/interrupt",
          "codeMark": "'turn/interrupt'"
        },
        "fork": {
          "command": "thread/fork",
          "codeMark": "'thread/fork'"
        },
        "compact": {
          "command": "thread/compact/start，等它的压缩轮结束再发下一轮",
          "codeMark": "'thread/compact/start'"
        },
        "set-model": {
          "command": "thread/settings/update（会话级），或 turn/start 带 model",
          "codeMark": "'thread/settings/update'"
        },
        "approve": {
          "command": "服务端请求 item/commandExecution|fileChange|permissions/requestApproval，回复 { decision }",
          "codeMark": "requestApproval"
        }
      }
    },
    "stream-json": {
      "does": "Claude Code 的常驻双向流（claude -p --input-format stream-json --output-format stream-json --permission-prompt-tool stdio）。驱动在 trace/apps/cli/src/drivers/claude_stream.ts，已接进后端 gateway.ts",
      "inBackend": true,
      "verbs": {
        "new": {
          "command": "claude -p --input-format stream-json --output-format stream-json --permission-prompt-tool stdio --model <模型>（常驻进程）",
          "codeMark": "'--input-format', 'stream-json'"
        },
        "resume": {
          "command": "同上加 --resume <会话编号>",
          "codeMark": "'--resume'"
        },
        "send": {
          "command": "stdin 写一条 {type:\"user\",message}；一轮进行中再写，会自成下一轮（注入·下一轮），不是插进当前这一轮",
          "codeMark": "type: 'control_request'"
        },
        "cancel": {
          "command": "control_request subtype=interrupt",
          "codeMark": "'interrupt'"
        },
        "fork": {
          "command": "同上加 --resume <父会话编号> --fork-session",
          "codeMark": "'--fork-session'"
        },
        "set-model": {
          "command": "control_request subtype=set_model（协议有；只列出了可选模型，没换模型真跑一轮，未证实）",
          "codeMark": "'set_model'"
        },
        "approve": {
          "command": "服务端发 control_request subtype=can_use_tool，一轮中挂起；回 control_response 放行或拒绝",
          "codeMark": "'can_use_tool'"
        }
      }
    },
    "acp-resident": {
      "does": "常驻地直连各产品的 ACP 桥（不经 acpx）：每个产品每个工作目录一个桥进程，会话载入一次后一直热着，空闲 15 分钟关掉。启动命令取 ~/.acpx/config.json 里 acpx 用的同一条 argv（没有就是 <acpxAgent> acp），环境取本表 env。驱动 trace/apps/cli/src/drivers/acp_runtime.ts，接在 gateway.ts 的 startAcpResidentRun；载入不了的会话这一轮退回 acpx",
      "inBackend": true,
      "verbs": {
        "new": {
          "command": "initialize → session/new（带 cwd）",
          "codeMark": "'session/new'"
        },
        "resume": {
          "command": "session/load（带会话编号和 cwd；载入时智能体会重放历史）",
          "codeMark": "'session/load'"
        },
        "send": {
          "command": "session/prompt（带图时是内容块数组）",
          "codeMark": "'session/prompt'"
        },
        "cancel": {
          "command": "session/cancel（通知），session/prompt 随后以 stopReason cancelled 结束",
          "codeMark": "'session/cancel'"
        },
        "set-model": {
          "command": "session/set_model，不认就 session/set_config_option {configId:\"model\"}",
          "codeMark": "'session/set_model'"
        },
        "set-mode": {
          "command": "session/set_mode，不认就 session/set_config_option {configId:\"mode\"}",
          "codeMark": "'session/set_mode'"
        },
        "approve": {
          "command": "服务端请求 session/request_permission，回 { outcome: { outcome: \"selected\", optionId } }；权限 all 放行、deny 拒绝、reads 放行读类，其余挂成轮内审批等人答；WorkBuddy 放行后还会请求 fs/write_text_file 让客户端代写",
          "codeMark": "session/request_permission"
        }
      }
    }
  },
