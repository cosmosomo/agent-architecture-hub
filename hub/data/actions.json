{
  "about": "动作表：后端 8899 提供的全部操作，一个接口一行。真源是 trace/apps/cli/src/server.ts 的路由；probe/scripts/build_tables.js 每次核对两边，有对不上的就报出来。cli 是命令行网关（hub/tools/agent_gateway.js）里调这个动作的子命令，没有就是网关还调不到。单元由哪个动作实现，写在 integration-map.json 的 action 字段里，引用这里的 id。 请求字段不在这里手写，由生成脚本从路由代码里抽。",
  "actions": [
    {
      "id": "send",
      "method": "POST",
      "path": "/api/gateway/send",
      "alias": [
        "/api/gateway/prompt"
      ],
      "does": "向一个会话发一轮；会话名是新的就新建；可带图、指定模型、目录、权限，traceSessionId 指向原生会话时接管它",
      "cli": "run"
    },
    {
      "id": "cancel",
      "method": "POST",
      "path": "/api/gateway/cancel",
      "does": "停下正在跑的这一轮，会话保留",
      "cli": "cancel"
    },
    {
      "id": "set-model",
      "method": "POST",
      "path": "/api/gateway/model",
      "does": "给产品或某个会话换模型（acpx 产品同时调 set-model）",
      "cli": "model"
    },
    {
      "id": "set-cwd",
      "method": "POST",
      "path": "/api/gateway/cwd",
      "does": "设定会话的工作目录"
    },
    {
      "id": "session-new",
      "method": "POST",
      "path": "/api/gateway/session/new",
      "does": "只建会话，不跑"
    },
    {
      "id": "resume",
      "method": "POST",
      "path": "/api/gateway/resume",
      "does": "恢复一个被打断的会话，接着跑"
    },
    {
      "id": "approve",
      "method": "POST",
      "path": "/api/gateway/approve",
      "does": "答复待审批项。现在是补齐：一轮因没权限失败后才生成待审批项，同意就全放行重跑一轮（搬到一个会话这一级）",
      "cli": "approve"
    },
    {
      "id": "handoff",
      "method": "POST",
      "path": "/api/gateway/handoff",
