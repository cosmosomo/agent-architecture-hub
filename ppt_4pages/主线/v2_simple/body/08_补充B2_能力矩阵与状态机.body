    <Box style={{ position: 'relative', zIndex: 1, width: '1280px', height: '720px', padding: '94px 56px 76px 56px', flexDirection: 'column' }}>
    <Text style={{ fontSize: 26.0, color: '#1E3A8A', fontWeight: 'bold' }}>能力详表：132 个能力单元四张表对账与受控状态机</Text>
    <Text style={{ fontSize: 13.8, color: '#64748B', marginTop: 5 }}>node hub/tools/agent_gateway.js tables 实时核对 ｜ 82 项功能 + 50 项显示交互 ｜ 额度排队与超时换人状态机</Text>
    <Box style={{ marginTop: 8, flexDirection: 'row', gap: 14, height: 424 }}>
    <Box style={{ width: 680, background: '#EEF2FF', borderTop: '4px solid #3730A3', borderRadius: 6, padding: '12px 14px', flexDirection: 'column', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 13.5, color: '#3730A3', fontWeight: 'bold' }}>四张表单一真源与 4 个位置实测对账（132 个能力单元 = 82 项功能 + 50 项显示交互）</Text>
    <Box style={{ flexDirection: 'row', gap: 6, marginTop: 6 }}>
    <Box style={{ flex: 1, background: '#FFFFFF', borderTop: '2.5px solid #3730A3', borderRadius: 4, padding: '6px 8px' }}>
    <Text style={{ fontSize: 11.8, color: '#3730A3', fontWeight: 'bold' }}>① capability-units.json</Text>
    <Text style={{ fontSize: 11.5, color: '#1E293B', marginTop: 2 }}>82 项功能 + 50 项显示交互定义</Text>
    </Box>
    <Box style={{ flex: 1, background: '#FFFFFF', borderTop: '2.5px solid #D97706', borderRadius: 4, padding: '6px 8px' }}>
