    <Box style={{ marginTop: 4, background: '#F0F7FF', border: '1px solid #BFDBFE', borderRadius: 3, padding: '3px 6px' }}>
    <Text style={{ fontSize: 9.3, color: '#1F2937' }}><span style={{ fontWeight: 'bold', color: '#073E87' }}>① 官方协议</span>：常驻 ACP、Codex app-server、Claude JSON、AGY RPC</Text>
    </Box>
    <Box style={{ marginTop: 3, background: '#F0F7FF', border: '1px solid #BFDBFE', borderRadius: 3, padding: '3px 6px' }}>
    <Text style={{ fontSize: 9.3, color: '#1F2937' }}><span style={{ fontWeight: 'bold', color: '#073E87' }}>② 桌面与网页 CDP</span>：豆包 9225 + OpenCLI 160+ 已登录网页（桌面 UI 实测 9 格）</Text>
    </Box>
    <Box style={{ marginTop: 3, background: '#F0F7FF', border: '1px solid #BFDBFE', borderRadius: 3, padding: '3px 6px' }}>
