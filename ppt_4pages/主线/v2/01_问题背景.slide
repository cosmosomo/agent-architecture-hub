    </Box>
    <Box style={{ marginTop: 4, background: '#ECFDF5', borderLeft: '2.5px solid #047857', borderRadius: 3, padding: '3px 6px' }}>
    <Text style={{ fontSize: 9.1, color: '#1F2937', lineHeight: 1.24 }}><span style={{ fontWeight: 'bold', color: '#047857' }}>✓ 为什么用成品</span>：自家应用(如 Claude Desktop/Code)享最高最强缓存率与补贴，极便宜</Text>
    </Box>
